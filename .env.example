# Copy to .env (gitignored). Never commit real values.
# Kobo: its URL and a throwaway test account's API token. On a production server
# (kf/eu.kobotoolbox.org) the scripts refuse unless KOBO_TEST_ACCOUNT_ON_PRODUCTION=yes
KOBO_URL=
KOBO_TOKEN=
KOBO_TEST_ACCOUNT_ON_PRODUCTION=
# The test droplet (deploy/up.sh)
ESPO_HOST=espo-test.kobolabs.dev
ESPO_SSH=root@espo-test.kobolabs.dev
# The agent runner (deploy/agents.sh): a Claude API key for agents with a model. Without
# one, rules-only agents still run; AGENTS_LLM=fake for the test model
ANTHROPIC_API_KEY=
AGENTS_LLM=real
