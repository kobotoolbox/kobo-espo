{
 "settings": {
  "form_title": "Responding organisation registration (espo-kobo test)",
  "form_id": "responder_registration",
  "version": "3"
 },
 "survey": [
  {
   "type": "end",
   "name": "end"
  },
  {
   "type": "select_one_from_file responses.csv",
   "name": "response",
   "label": "Which response are you responding to?",
   "required": "true"
  },
  {
   "type": "select_one org_types",
   "name": "org_type",
   "label": "Organization type",
   "required": "true",
   "appearance": "minimal"
  },
  {
   "type": "select_one_from_file organisations.csv",
   "name": "organisation",
   "label": "Organization name",
   "required": "true",
   "appearance": "minimal",
   "choice_filter": "org_type=${org_type} or name='other'"
  },
  {
   "type": "text",
   "name": "organisation_other",
   "label": "Specify organization name",
   "required": "true",
   "relevant": "${organisation} = 'other'"
  },
  {
   "type": "text",
   "name": "org_acronym",
   "label": "Acronym"
  },
  {
   "type": "select_multiple sectors",
   "name": "sectors",
   "label": "Which sectors do you work in?",
   "required": "true"
  },
  {
   "type": "text",
   "name": "focal_name",
   "label": "Focal point: name",
   "required": "true"
  },
  {
   "type": "text",
   "name": "focal_email",
   "label": "Focal point: email",
   "required": "true",
   "constraint": "regex(., '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$')"
  },
  {
   "type": "text",
   "name": "focal_phone",
   "label": "Focal point: phone"
  },
  {
   "type": "text",
   "name": "focal_position",
   "label": "Focal point: position"
  },
  {
   "type": "begin_repeat",
   "name": "FOCAL_POINTS",
   "label": "Other focal points (optional)",
   "hint": "Others the coordinators can contact about your organisation's work in this response"
  },
  {
   "type": "text",
   "name": "name",
   "label": "Name"
  },
  {
   "type": "text",
   "name": "email",
   "label": "Email",
   "constraint": "regex(., '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$')"
  },
  {
   "type": "text",
   "name": "phone",
   "label": "Phone"
  },
  {
   "type": "text",
   "name": "position",
   "label": "Position"
  },
  {
   "type": "end_repeat"
  },
  {
   "type": "calculate",
   "name": "registration_key",
   "calculation": "concat(${response}, '/', if(${organisation} = 'other', ${organisation_other}, ${organisation}))"
  }
 ],
 "choices": [
  {
   "list_name": "org_types",
   "name": "NATIONAL_NGO",
   "label": "National NGO"
  },
  {
   "list_name": "org_types",
   "name": "INTERNATIONAL_NGO",
   "label": "International NGO"
  },
  {
   "list_name": "org_types",
   "name": "UN_AGENCY",
   "label": "UN Agency"
  },
  {
   "list_name": "org_types",
   "name": "GOVERNMENT",
   "label": "Government"
  },
  {
   "list_name": "org_types",
   "name": "RED_CROSS_MOVEMENT",
   "label": "Red Cross/Red Cresent Movment"
  },
  {
   "list_name": "org_types",
   "name": "DONOR",
   "label": "Donor"
  },
  {
   "list_name": "org_types",
   "name": "PRIVATE_SECTOR",
   "label": "Private Sector"
  },
  {
   "list_name": "org_types",
   "name": "other",
   "label": "Other"
  },
  {
   "list_name": "sectors",
   "name": "CASH",
   "label": "Cash Transfer"
  },
  {
   "list_name": "sectors",
   "name": "CHILD_PROTECTION",
   "label": "Child Protection"
  },
  {
   "list_name": "sectors",
   "name": "COORDINATION",
   "label": "Coordination"
  },
  {
   "list_name": "sectors",
   "name": "EARLY_RECOVERY",
   "label": "Early recovery"
  },
  {
   "list_name": "sectors",
   "name": "EDUCATION",
   "label": "Education"
  },
  {
   "list_name": "sectors",
   "name": "EMERGENCY_TELECOMS",
   "label": "Emergency Telecommunications"
  },
  {
   "list_name": "sectors",
   "name": "FOOD_SECURITY",
   "label": "Food Security"
  },
  {
   "list_name": "sectors",
   "name": "HEALTH",
   "label": "Health"
  },
  {
   "list_name": "sectors",
   "name": "NUTRITION",
   "label": "Nutrition"
  },
  {
   "list_name": "sectors",
   "name": "PROTECTION",
   "label": "Protection"
  },
  {
   "list_name": "sectors",
   "name": "SHELTER",
   "label": "Shelter & NFIs"
  },
  {
   "list_name": "sectors",
   "name": "WASH",
   "label": "WASH"
  },
  {
   "list_name": "sectors",
   "name": "other_sector",
   "label": "Other"
  }
 ]
}
