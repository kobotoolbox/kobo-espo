{
 "settings": {
  "form_title": "CSO profile (espo-kobo test)",
  "form_id": "cso_profile",
  "version": "1",
  "style": "pages"
 },
 "survey": [
  {
   "type": "start",
   "name": "start"
  },
  {
   "type": "end",
   "name": "end"
  },
  {
   "type": "hidden",
   "name": "cso"
  },
  {
   "type": "hidden",
   "name": "key"
  },
  {
   "type": "note",
   "name": "intro",
   "label": "This profile maps civil society organisations working on health emergencies, so that WHO and partners can coordinate and CSOs can connect with one another. It takes about 15 minutes. You can send it again later to update it."
  },
  {
   "type": "begin_group",
   "name": "about",
   "label": "About the organization"
  },
  {
   "type": "text",
   "name": "cso_name",
   "label": "What is the official name of your organization?",
   "required": "true"
  },
  {
   "type": "text",
   "name": "acronym",
   "label": "Commonly used acronym, if any"
  },
  {
   "type": "select_one cso_types",
   "name": "cso_type",
   "label": "Which type of civil society organization best describes your organization?",
   "required": "true"
  },
  {
   "type": "text",
   "name": "cso_type_other",
   "label": "Please specify",
   "required": "true",
   "relevant": "${cso_type} = 'other'"
  },
  {
   "type": "select_one countries",
   "name": "country_registered",
   "label": "In which country is your organization headquartered or formally registered?",
   "required": "true",
   "appearance": "minimal autocomplete"
  },
  {
   "type": "select_multiple levels",
   "name": "levels",
   "label": "At what level does your organization mainly operate?",
   "required": "true"
  },
  {
   "type": "end_group"
  },
  {
   "type": "begin_repeat",
   "name": "FOCAL_POINTS",
   "label": "Focal point for this mapping"
  },
  {
   "type": "text",
   "name": "name",
   "label": "Name",
   "required": "true"
  },
  {
   "type": "text",
   "name": "position",
   "label": "Position"
  },
  {
   "type": "text",
   "name": "email",
   "label": "Email",
   "required": "true",
   "constraint": "regex(., '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$')",
   "constraint_message": "An email address, please."
  },
  {
   "type": "text",
   "name": "phone",
   "label": "Telephone/WhatsApp",
   "hint": "With the country code, e.g. +254 712 345678"
  },
  {
   "type": "end_repeat"
  },
  {
   "type": "note",
   "name": "focal_more",
   "label": "Add a second focal point (the + button) so the profile still reaches someone if one person leaves."
  },
  {
   "type": "select_one sharing",
   "name": "sharing",
   "label": "May the organization's profile and designated contact details be shared with other participating CSOs and authorized partners for coordination and collaboration?",
   "required": "true"
  },
  {
   "type": "begin_group",
   "name": "where",
   "label": "Where the organization works"
  },
  {
   "type": "begin_repeat",
   "name": "PRESENCE",
   "label": "A place where your organization has an operational presence"
  },
  {
   "type": "select_one countries",
   "name": "country",
   "label": "Country",
   "required": "true",
   "appearance": "minimal autocomplete"
  },
  {
   "type": "geopoint",
   "name": "location",
   "label": "Drop a pin in the place",
   "required": "true",
   "hint": "Anywhere in the district or area: it is matched to the admin area it falls in."
  },
  {
   "type": "end_repeat"
  },
  {
   "type": "select_multiple settings",
   "name": "settings",
   "label": "Which types of settings can your organization reach?",
   "required": "true"
  },
  {
   "type": "text",
   "name": "settings_other",
   "label": "Please specify",
   "required": "true",
   "relevant": "selected(${settings}, 'other')"
  },
  {
   "type": "select_multiple populations",
   "name": "populations",
   "label": "Which population groups or communities does your organization principally work with?",
   "required": "true"
  },
  {
   "type": "text",
   "name": "populations_other",
   "label": "Please specify",
   "required": "true",
   "relevant": "selected(${populations}, 'other')"
  },
  {
   "type": "end_group"
  },
  {
   "type": "begin_group",
   "name": "does",
   "label": "What the organization does"
  },
  {
   "type": "select_multiple stages",
   "name": "stages",
   "label": "In which stages of health emergency management does your organization currently work or has worked?",
   "required": "true"
  },
  {
   "type": "select_multiple roles",
   "name": "roles",
   "label": "What roles or activities does your organization currently undertake or has undertaken in health emergencies?",
   "required": "true"
  },
  {
   "type": "text",
   "name": "roles_other",
   "label": "Please specify",
   "required": "true",
   "relevant": "selected(${roles}, 'other')"
  },
  {
   "type": "select_multiple hazards",
   "name": "hazards",
   "label": "For which hazards, diseases or emergency contexts does your organization have experience or current activities?",
   "required": "true"
  },
  {
   "type": "text",
   "name": "hazards_other",
   "label": "Please specify",
   "required": "true",
   "relevant": "selected(${hazards}, 'other')"
  },
  {
   "type": "select_multiple roles",
   "name": "roles_with_support",
   "label": "Which of these roles could your organization undertake if additional support or resources were available?"
  },
  {
   "type": "text",
   "name": "roles_with_support_other",
   "label": "Please specify",
   "required": "true",
   "relevant": "selected(${roles_with_support}, 'other')"
  },
  {
   "type": "end_group"
  },
  {
   "type": "begin_group",
   "name": "coordination",
   "label": "Coordination, capacity and collaboration"
  },
  {
   "type": "select_multiple mechanisms",
   "name": "mechanisms",
   "label": "In which coordination or decision-making mechanisms does your organization currently participate?",
   "required": "true",
   "constraint": "not(selected(., 'none') and count-selected(.) > 1)",
   "constraint_message": "\"Not currently participating\" goes alone."
  },
  {
   "type": "text",
   "name": "mechanisms_other",
   "label": "Please specify",
   "required": "true",
   "relevant": "selected(${mechanisms}, 'other')"
  },
  {
   "type": "select_multiple exchange",
   "name": "offers",
   "label": "What could your organization offer other CSOs or partners?",
   "required": "true",
   "constraint": "count-selected(.) <= 3",
   "constraint_message": "Choose at most 3.",
   "hint": "Choose up to 3."
  },
  {
   "type": "text",
   "name": "offers_other",
   "label": "Please specify",
   "required": "true",
   "relevant": "selected(${offers}, 'other')"
  },
  {
   "type": "select_multiple exchange",
   "name": "seeks",
   "label": "What support, expertise or partnership is your organization currently seeking?",
   "constraint": "count-selected(.) <= 3",
   "constraint_message": "Choose at most 3.",
   "hint": "Choose up to 3."
  },
  {
   "type": "text",
   "name": "seeks_other",
   "label": "Please specify",
   "required": "true",
   "relevant": "selected(${seeks}, 'other')"
  },
  {
   "type": "select_multiple connect_via",
   "name": "connect_via",
   "label": "How would your organization prefer to connect and exchange information with other CSOs?",
   "required": "true"
  },
  {
   "type": "text",
   "name": "connect_via_other",
   "label": "Please specify",
   "required": "true",
   "relevant": "selected(${connect_via}, 'other')"
  },
  {
   "type": "end_group"
  }
 ],
