{
 "settings": {
  "form_title": "CSO update: Kenya (espo-kobo test)",
  "form_id": "cso_update_ken",
  "version": "1",
  "style": "pages"
 },
 "survey": [
  {
   "type": "start",
   "name": "start"
  },
  {
   "type": "end",
   "name": "end"
  },
  {
   "type": "hidden",
   "name": "cso"
  },
  {
   "type": "hidden",
   "name": "key"
  },
  {
   "type": "note",
   "name": "intro",
   "label": "A short update on what your organization is doing in one place. Send one per place."
  },
  {
   "type": "text",
   "name": "cso_typed",
   "label": "Your organization's CSO code",
   "required": "true",
   "relevant": "${cso} = ''",
   "hint": "CSO- and 4 characters, in the email you got after sending your profile.",
   "constraint": "regex(., '^CSO-[2-9A-HJKMNP-TV-Z]{4}$')",
   "constraint_message": "A code like CSO-7K3Q."
  },
  {
   "type": "calculate",
   "name": "cso_code",
   "calculation": "if(${cso} != '', ${cso}, ${cso_typed})"
  },
  {
   "type": "begin_group",
   "name": "place",
   "label": "Where is this activity being implemented?"
  },
  {
   "type": "select_one_from_file areas.csv",
   "name": "admin1",
   "label": "County",
   "required": "true",
   "choice_filter": "level='admin1'",
   "appearance": "minimal"
  },
  {
   "type": "select_one_from_file areas.csv",
   "name": "admin2",
   "label": "Sub-county",
   "required": "true",
   "choice_filter": "parent=${admin1}",
   "appearance": "minimal"
  },
  {
   "type": "calculate",
   "name": "area",
   "calculation": "if(${admin2} != '', ${admin2}, ${admin1})"
  },
  {
   "type": "hidden",
   "name": "country",
   "default": "KEN"
  },
  {
   "type": "text",
   "name": "locality",
   "label": "Locality (village, town or neighbourhood)"
  },
  {
   "type": "geopoint",
   "name": "location",
   "label": "Location (optional)"
  },
  {
   "type": "end_group"
  },
  {
   "type": "select_multiple roles",
   "name": "roles",
   "label": "What activity or service are you currently providing in this location?",
   "required": "true"
  },
  {
   "type": "text",
   "name": "roles_other",
   "label": "Please specify",
   "required": "true",
   "relevant": "selected(${roles}, 'other')"
  },
  {
   "type": "select_one update_status",
   "name": "status",
   "label": "What is the current status?",
   "required": "true"
  },
  {
   "type": "select_multiple populations",
   "name": "populations",
   "label": "Which population groups are being reached?",
   "required": "true"
  },
  {
   "type": "text",
   "name": "populations_other",
   "label": "Please specify",
   "required": "true",
   "relevant": "selected(${populations}, 'other')"
  },
  {
   "type": "text",
   "name": "facility",
   "label": "Facility being reached, if any (its name)"
  },
  {
   "type": "select_multiple exchange",
   "name": "needs",
   "label": "What is the principal operational gap or collaboration need in this location?",
   "constraint": "count-selected(.) <= 3",
   "constraint_message": "Choose at most 3.",
   "hint": "Choose up to 3."
  },
  {
   "type": "text",
   "name": "needs_other",
   "label": "Please specify",
   "required": "true",
   "relevant": "selected(${needs}, 'other')"
  },
  {
   "type": "text",
   "name": "needs_note",
   "label": "A short explanation of the need",
   "relevant": "count-selected(${needs}) > 0"
  }
 ],
