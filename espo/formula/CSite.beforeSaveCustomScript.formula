// A site is in its project's teams, or without a project its response's, like its tasks:
// the project's (or response's) members see it. A project's site is in its response too.
if (projectId && (entity\isNew() || entity\isAttributeChanged('projectId'))) {
    $teams = record\attribute('CProject', projectId, 'teamsIds');
    if (array\length($teams) > 0) {
        teamsIds = $teams;
    }
    $response = record\attribute('CProject', projectId, 'responseId');
    if ($response) {
        responseId = $response;
    }
} else if (!projectId && responseId && (entity\isNew() || entity\isAttributeChanged('responseId'))) {
    $teams = record\attribute('CResponse', responseId, 'teamsIds');
    if (array\length($teams) > 0) {
        teamsIds = $teams;
    }
}
