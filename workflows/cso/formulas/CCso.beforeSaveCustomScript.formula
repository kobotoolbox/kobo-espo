// Workflow F (plans/cso-mapping-plan.md): a CSO's profile. Its key, for the links it is
// emailed (the profile's and the update form's): given once, 16 characters. The key a
// submission came with is checked (API script, updates) and never kept
if (!updateKey) {
    $alphabet = '23456789ABCDEFGHJKMNPQRSTVWXYZabcdefghjkmnpqrstvwxyz';
    $c = '';
    $k = 0;
    while ($k < 16) {
        $c = string\concatenate($c, string\substring($alphabet, number\randomInt(0, 51), 1));
        $k = $k + 1;
    }
    updateKey = $c;
}
keyGiven = null;

// Sent again from Kobo (a new submission): the profile's date is today, and the places
// the submission before gave are no longer current (the new one's rows follow). Places
// added in the portal stay: the portal is where a CSO keeps them. Its contacts aren't
// replaced either (the profile's are matched by email). Its countries start again from
// where it's registered and the others it named
$resent = entity\isNew() || entity\isAttributeChanged('cKoboSubmissionUuid');
if ($resent) {
    lastProfile = datetime\today();
    if (!entity\isNew()) {
        $rows = record\findMany('CPresence', 500, 'createdAt', 'asc', 'csoId=', id, 'current=', true);
        $i = 0;
        while ($i < array\length($rows)) {
            $r = array\at($rows, $i);
            if (record\attribute('CPresence', $r, 'cKoboSubmissionUuid') != cKoboSubmissionUuid
                    && record\attribute('User', record\attribute('CPresence', $r, 'createdById'), 'type') != 'portal') {
                record\update('CPresence', $r, 'current', false);
            }
            $i = $i + 1;
        }
    }
    $countries = ifThenElse(otherCountries, otherCountries, list());
    if (countryRegistered && !array\includes($countries, countryRegistered)) {
        $countries = array\push($countries, countryRegistered);
    }
    countries = $countries;
}

// Who else sees it: listed in the directory and the matching unless it said no, and its
// contacts there only if it said yes (those still its and in the directory; the
// contacts' formula keeps it when they change)
listed = sharing == 'yes' || sharing == 'profile_only';
if (entity\isNew() || $resent || entity\isAttributeChanged('sharing')) {
    $text = '';
    if (sharing == 'yes' && !entity\isNew()) {
        $cs = record\findMany('Contact', 50, 'createdAt', 'asc', 'cCsoId=', id, 'cCsoActive=', true, 'cCsoShared=', true);
        $i = 0;
        while ($i < array\length($cs)) {
            $f = array\at($cs, $i);
            $text = string\concatenate($text, ifThenElse($text, '\n', ''),
                string\trim(string\concatenate(record\attribute('Contact', $f, 'firstName'), ' ', record\attribute('Contact', $f, 'lastName'))),
                ifThenElse(record\attribute('Contact', $f, 'title'), string\concatenate(' (', record\attribute('Contact', $f, 'title'), ')'), ''),
                ifThenElse(record\attribute('Contact', $f, 'emailAddress'), string\concatenate(', ', record\attribute('Contact', $f, 'emailAddress')), ''),
                ifThenElse(record\attribute('Contact', $f, 'phoneNumber'), string\concatenate(', ', record\attribute('Contact', $f, 'phoneNumber')), ''));
            $i = $i + 1;
        }
    }
    sharedContact = ifThenElse($text, $text, null);
}

// Its teams: each of its countries' ("CSO: " and the country's admin0 name, e.g. CSO:
// Kenya), or CSO: Unassigned when none of them has a team
if (entity\isNew() || entity\isAttributeChanged('countries')) {
    $teams = list();
    $i = 0;
    while ($i < array\length(countries)) {
        $a0 = record\findOne('CAdminArea', 'createdAt', 'asc', 'country=', array\at(countries, $i), 'level=', 'admin0');
        if ($a0) {
            $t = record\findOne('Team', 'createdAt', 'asc', 'name=', string\concatenate('CSO: ', record\attribute('CAdminArea', $a0, 'name')));
            if ($t && !array\includes($teams, $t)) {
                $teams = array\push($teams, $t);
            }
        }
        $i = $i + 1;
    }
    if (array\length($teams) == 0) {
        $t = record\findOne('Team', 'createdAt', 'asc', 'name=', 'CSO: Unassigned');
        if ($t) {
            $teams = list($t);
        }
    }
    teamsIds = $teams;
}

// Its Account (what the portal's "account" level follows): made with it, named after it,
// in its teams
if (!accountId) {
    accountId = record\create('Account', 'name', name, 'teamsIds', teamsIds);
} else if (entity\isAttributeChanged('name') || entity\isAttributeChanged('teamsIds')) {
    record\update('Account', accountId, 'name', name, 'teamsIds', teamsIds);
}
// Its places, updates and contacts follow its teams, its Account and what the dashboard's
// feeds read of it: the trait cascade (their inherit, workflow.toml)
