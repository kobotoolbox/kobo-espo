// Workflow F: a CSO's operational update (one submission of the update form). Its own
// when it came with the CSO's key (the link in the CSO's email): otherwise it's kept,
// flagged, and not counted until a coordinator confirms it. The key is never kept. Its
// CSO (made in the portal: its people's), where it is, its CSO's teams, its data checks
// and which update counts: traits (workflow.toml)
// Made in the portal, it's the CSO's own (its people signed in): no key needed
if (entity\isNew() && csoId) {
    keyCheck = ifThenElse(env\userAttribute('type') == 'portal', 'ok', ifThenElse(!keyGiven, 'missing',
        ifThenElse(keyGiven == record\attribute('CCso', csoId, 'updateKey'), 'ok', 'wrong')));
}
keyGiven = null;

// Named after the CSO and the place
if (entity\isNew() || entity\isAttributeChanged('adminAreaId') || entity\isAttributeChanged('csoId')) {
    name = string\concatenate(ifThenElse(csoId, record\attribute('CCso', csoId, 'name'), 'CSO'), ': ',
        ifThenElse(adminAreaId, record\attribute('CAdminArea', adminAreaId, 'name'), ifThenElse(locality, locality, 'place to be P-coded')));
}

// For the data checks: a role here that its profile doesn't have
$roleNotInProfile = false;
if (csoId && roles) {
    $profile = record\attribute('CCso', csoId, 'roles');
    $i = 0;
    while ($i < array\length(roles)) {
        if (array\at(roles, $i) != 'other' && !array\includes($profile, array\at(roles, $i))) {
            $roleNotInProfile = true;
        }
        $i = $i + 1;
    }
}
