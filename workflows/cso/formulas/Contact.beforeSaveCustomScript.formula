// Workflow F: a CSO's contact (a focal point, from its Kobo profile or added in the CSO
// portal). Its CSO (added in the portal: that of whoever added it), its CSO's Account and
// teams: traits (workflow.toml)
// The CSO's shared contact, when the CSO said yes: its contacts still its and in the
// directory, this one as it is now
if (cCsoId && (entity\isNew() || entity\isAttributeChanged('firstName') || entity\isAttributeChanged('lastName')
        || entity\isAttributeChanged('title') || entity\isAttributeChanged('emailAddress') || entity\isAttributeChanged('phoneNumber')
        || entity\isAttributeChanged('cCsoActive') || entity\isAttributeChanged('cCsoShared') || entity\isAttributeChanged('cCsoId'))) {
    $text = '';
    if (record\attribute('CCso', cCsoId, 'sharing') == 'yes') {
        if (cCsoActive && cCsoShared) {
            $text = string\concatenate(string\trim(string\concatenate(firstName, ' ', lastName)),
                ifThenElse(title, string\concatenate(' (', title, ')'), ''),
                ifThenElse(emailAddress, string\concatenate(', ', emailAddress), ''),
                ifThenElse(phoneNumber, string\concatenate(', ', phoneNumber), ''));
        }
        $cs = record\findMany('Contact', 50, 'createdAt', 'asc', 'cCsoId=', cCsoId, 'cCsoActive=', true, 'cCsoShared=', true);
        $i = 0;
        while ($i < array\length($cs)) {
            $f = array\at($cs, $i);
            if ($f != id) {
                $text = string\concatenate($text, ifThenElse($text, '\n', ''),
                    string\trim(string\concatenate(record\attribute('Contact', $f, 'firstName'), ' ', record\attribute('Contact', $f, 'lastName'))),
                    ifThenElse(record\attribute('Contact', $f, 'title'), string\concatenate(' (', record\attribute('Contact', $f, 'title'), ')'), ''),
                    ifThenElse(record\attribute('Contact', $f, 'emailAddress'), string\concatenate(', ', record\attribute('Contact', $f, 'emailAddress')), ''),
                    ifThenElse(record\attribute('Contact', $f, 'phoneNumber'), string\concatenate(', ', record\attribute('Contact', $f, 'phoneNumber')), ''));
            }
            $i = $i + 1;
        }
    }
    record\update('CCso', cCsoId, 'sharedContact', ifThenElse($text, $text, null));
}

// The welcome email: a new focal point from Kobo (not one added in the portal, whose people
// know the CSO already) gets the CSO's code and its links: the update form and the profile
// form with its code and key filled in, and the portal. Made here as a scheduled email
// (EspoCRM's job sends it within minutes), so an email problem never stops a registration.
// The instance's parameters (deploy/instance.toml [params.cso]) turn it on and give the links
if (entity\isNew() && cCsoId && emailAddress && env\userAttribute('type') != 'portal' && {{welcome_email}} == 'on'
        && ({{email_only_to}} == '' || string\contains(string\lowerCase(emailAddress), {{email_only_to}}))) {
    $code = record\attribute('CCso', cCsoId, 'code');
    $key = record\attribute('CCso', cCsoId, 'updateKey');
    $cso = record\attribute('CCso', cCsoId, 'name');
    $c = record\attribute('CCso', cCsoId, 'countryRegistered');
    $update = string\replace(string\replace({{pick update_links $c}}, '{code}', $code), '{key}', $key);
    $profile = string\replace(string\replace({{pick profile_links $c}}, '{code}', $code), '{key}', $key);
    $body = string\concatenate('<p>Hello ', ifThenElse(firstName, firstName, ''), ',</p>',
        '<p><strong>', $cso, '</strong> is in the CSO mapping, with the code <strong>', $code, '</strong>. ',
        'You are one of its focal points.</p>',
        ifThenElse($update, string\concatenate('<p><strong>To say what your organisation is doing in a place</strong> ',
            '(and what it needs there), use this link: it fills in your code for you.<br><a href="', $update, '">', $update, '</a></p>'), ''),
        ifThenElse($profile, string\concatenate('<p>To send your profile again from Kobo: <a href="', $profile, '">', $profile, '</a></p>'), ''),
        ifThenElse({{portal_url}}, string\concatenate('<p>Your coordinator can give you a login to the <strong>CSO portal</strong>, ',
            'where you keep your profile, places and contacts up to date: <a href="', {{portal_url}}, '">', {{portal_url}}, '</a></p>'), ''),
        '<p>Keep these links to yourself: they let whoever has them report for your organisation.</p>');
    record\create('Email', 'name', string\concatenate($cso, ': your code and links for the CSO mapping'),
        'body', $body, 'isHtml', true, 'to', emailAddress, 'from', {{from}}, 'status', 'Draft',
        'sendAt', datetime\addMinutes(datetime\now(), 2), 'parentType', 'Account', 'parentId', accountId);
}
