// An area an assessment covers (a row of its form's AREAS repeat): its assessment's teams,
// response, Account, sectors, status and dates, and its P-codes: traits (workflow.toml).
// In its assessment's latest submission (its formula marks the others not current)
if (entity\isNew() || entity\isAttributeChanged('cKoboSubmissionUuid')) {
    current = true;
}
// Named after its assessment and its area ("ASM-7K3Q: Kingston"), as they're named now
// (areas re-keyed)
if (assessmentId) {
    name = string\concatenate(record\attribute('CAssessment', assessmentId, 'code'), ': ',
        ifThenElse(adminAreaId, record\attribute('CAdminArea', adminAreaId, 'name'), ifThenElse(pcode, pcode, 'area')));
}
