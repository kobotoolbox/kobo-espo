// A responding organisation is in its response's teams and in those of the response's
// projects in the sectors it works in: those sectors' people see it, and the coordinators
if (responseId && (entity\isNew() || entity\isAttributeChanged('responseId') || entity\isAttributeChanged('clusters'))) {
    $teams = record\attribute('CResponse', responseId, 'teamsIds');
    $projects = record\findMany('CProject', 200, 'createdAt', 'asc', 'responseId=', responseId);
    $i = 0;
    while ($i < array\length($projects)) {
        $p = array\at($projects, $i);
        if (array\includes(clusters, record\attribute('CProject', $p, 'cluster'))) {
            $add = record\attribute('CProject', $p, 'teamsIds');
            $j = 0;
            while ($j < array\length($add)) {
                if (!array\includes($teams, array\at($add, $j))) {
                    $teams = array\push($teams, array\at($add, $j));
                }
                $j = $j + 1;
            }
        }
        $i = $i + 1;
    }
    if (array\length($teams) > 0) {
        teamsIds = $teams;
    }
}

// Named after its organisation in the list (or the one it typed), with its type
if (organisationId && (entity\isNew() || entity\isAttributeChanged('organisationId') || entity\isAttributeChanged('organisationOther'))) {
    if (record\attribute('COrganisation', organisationId, 'code') == 'other') {
        if (organisationOther) {
            name = organisationOther;
        }
    } else {
        name = record\attribute('COrganisation', organisationId, 'name');
        orgType = record\attribute('COrganisation', organisationId, 'orgType');
    }
}

// Its organisation's Account (one per organisation, whatever the response): the one linked
// to its organisation in the list, else (typed in, "Other") the unlisted one of that name;
// made if there's none. A typed-in organisation later picked from the list: the
// registration moves to that organisation's Account, or its Account takes the list entry.
// Its teams: all the organisation's registrations' (trait teams_up, workflow.toml)
$listed = organisationId && record\attribute('COrganisation', organisationId, 'code') != 'other';
if (!accountId || entity\isAttributeChanged('organisationId') || entity\isAttributeChanged('organisationOther')) {
    $acc = null;
    if ($listed) {
        $acc = record\findOne('Account', 'createdAt', 'asc', 'cOrganisationId=', organisationId);
        if (!$acc && accountId && !record\attribute('Account', accountId, 'cOrganisationId')) {
            record\update('Account', accountId, 'cOrganisationId', organisationId, 'name', name);
            $acc = accountId;
        }
    } else if (organisationOther) {
        $acc = record\findOne('Account', 'createdAt', 'asc', 'name=', organisationOther, 'cOrganisationId=', null);
    }
    if (!$acc && ($listed || organisationOther)) {
        $acc = record\create('Account', 'name', name, 'cOrganisationId', ifThenElse($listed, organisationId, null),
            'cAcronym', acronym, 'cOrgType', orgType);
    }
    if ($acc) {
        accountId = $acc;
    }
}
