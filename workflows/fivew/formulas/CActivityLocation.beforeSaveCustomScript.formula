// A location is its activity's: its project, response and teams (trait inherit, workflow.toml)

// The parish from the community, if it wasn't given; named after them
if (communityId && !parishId) {
    parishId = record\findOne('CAdminArea', 'createdAt', 'asc', 'pcode=', record\attribute('CAdminArea', communityId, 'parentPcode'));
}
if (communityId && (entity\isNew() || entity\isAttributeChanged('communityId'))) {
    name = string\concatenate(record\attribute('CAdminArea', communityId, 'name'),
        ifThenElse(parishId, string\concatenate(', ', record\attribute('CAdminArea', parishId, 'name')), ''));
}

// Its activity's who and what, for one from before they were copied (the trait copies them
// when it's made or moved, and its activity's changes follow); its parish's P-code
if (activityId && !sector && record\attribute('CActivity', activityId, 'sector')) {
    leadOrganisationId = record\attribute('CActivity', activityId, 'leadOrganisationId');
    sector = record\attribute('CActivity', activityId, 'sector');
    activityKind = record\attribute('CActivity', activityId, 'activityType');
    activityKindOther = record\attribute('CActivity', activityId, 'activityTypeOther');
    status = record\attribute('CActivity', activityId, 'status');
}
if (parishId && (!pcode1 || entity\isAttributeChanged('parishId'))) {
    pcode1 = record\attribute('CAdminArea', parishId, 'pcode');
}

// Overlaps, for the ICCG (duplication across clusters, UNDAC Handbook G.6): another
// organisation's activity of the same sector and type ("other": the same typed-in type) in
// this community in the response, neither completed. This one is flagged, naming the others
$overlaps = '';
if (responseId && communityId && sector && activityKind && status != 'COMPLETED') {
    $others = record\findMany('CActivityLocation', 500, 'createdAt', 'asc', 'responseId=', responseId, 'communityId=', communityId);
    $i = 0;
    while ($i < array\length($others)) {
        $o = array\at($others, $i);
        $acc = record\attribute('CActivityLocation', $o, 'accountId');
        $org = record\attribute('CActivityLocation', $o, 'leadOrganisationId');
        $same = $o == id || record\attribute('CActivityLocation', $o, 'activityId') == activityId
            || ifThenElse(accountId && $acc, $acc == accountId, $org == leadOrganisationId);
        if (!$same && record\attribute('CActivityLocation', $o, 'sector') == sector
                && record\attribute('CActivityLocation', $o, 'activityKind') == activityKind
                && (activityKind != 'other' || string\lowerCase(string\trim(record\attribute('CActivityLocation', $o, 'activityKindOther')))
                    == string\lowerCase(string\trim(activityKindOther)))
                && record\attribute('CActivityLocation', $o, 'status') != 'COMPLETED') {
            $who = ifThenElse($acc, record\attribute('Account', $acc, 'name'), record\attribute('COrganisation', $org, 'name'));
            $what = record\attribute('CActivity', record\attribute('CActivityLocation', $o, 'activityId'), 'code');
            if (!string\contains($overlaps, $what)) {
                $overlaps = string\concatenate($overlaps, ifThenElse($overlaps, ', ', ''), $who, ' (', $what, ')');
            }
        }
        $i = $i + 1;
    }
}
overlapsWith = ifThenElse($overlaps, $overlaps, null);

// The activity's totals: this location and its others
if (activityId) {
    $ids = record\findMany('CActivityLocation', 500, 'createdAt', 'asc', 'activityId=', activityId);
    $n = 1;
    $reached = ifThenElse(populationReached, populationReached, 0);
    $targeted = ifThenElse(populationTargeted, populationTargeted, 0);
    $quantity = ifThenElse(quantity, quantity, 0);
    $budget = ifThenElse(budget, budget, 0);
    $i = 0;
    while ($i < array\length($ids)) {
        $o = array\at($ids, $i);
        if ($o != id) {
            $n = $n + 1;
            $reached = $reached + ifThenElse(record\attribute('CActivityLocation', $o, 'populationReached'),
                record\attribute('CActivityLocation', $o, 'populationReached'), 0);
            $targeted = $targeted + ifThenElse(record\attribute('CActivityLocation', $o, 'populationTargeted'),
                record\attribute('CActivityLocation', $o, 'populationTargeted'), 0);
            $quantity = $quantity + ifThenElse(record\attribute('CActivityLocation', $o, 'quantity'),
                record\attribute('CActivityLocation', $o, 'quantity'), 0);
            $budget = $budget + ifThenElse(record\attribute('CActivityLocation', $o, 'budget'),
                record\attribute('CActivityLocation', $o, 'budget'), 0);
        }
        $i = $i + 1;
    }
    record\update('CActivity', activityId, 'communities', $n, 'peopleReached', $reached,
        'peopleTargeted', $targeted, 'quantity', $quantity, 'budget', $budget);
}

// For the data checks (the trait checks, workflow.toml): the groups' total, and whether a
// group's women, men and children add up to its people
$groups = ifThenElse(idpPeopleReached, idpPeopleReached, 0) + ifThenElse(hostingPeopleReached, hostingPeopleReached, 0) + ifThenElse(ndpPeopleReached, ndpPeopleReached, 0) + ifThenElse(otherPeopleReached, otherPeopleReached, 0);
$parts = false;
if (idpPeopleTargeted && (idpWomenTargeted || idpMenTargeted || idpChildrenTargeted) && idpPeopleTargeted != ifThenElse(idpWomenTargeted, idpWomenTargeted, 0) + ifThenElse(idpMenTargeted, idpMenTargeted, 0) + ifThenElse(idpChildrenTargeted, idpChildrenTargeted, 0)) {
    $parts = true;
}
if (idpPeopleReached && (idpWomenReached || idpMenReached || idpChildrenReached) && idpPeopleReached != ifThenElse(idpWomenReached, idpWomenReached, 0) + ifThenElse(idpMenReached, idpMenReached, 0) + ifThenElse(idpChildrenReached, idpChildrenReached, 0)) {
    $parts = true;
}
if (hostingPeopleTargeted && (hostingWomenTargeted || hostingMenTargeted || hostingChildrenTargeted) && hostingPeopleTargeted != ifThenElse(hostingWomenTargeted, hostingWomenTargeted, 0) + ifThenElse(hostingMenTargeted, hostingMenTargeted, 0) + ifThenElse(hostingChildrenTargeted, hostingChildrenTargeted, 0)) {
    $parts = true;
}
if (hostingPeopleReached && (hostingWomenReached || hostingMenReached || hostingChildrenReached) && hostingPeopleReached != ifThenElse(hostingWomenReached, hostingWomenReached, 0) + ifThenElse(hostingMenReached, hostingMenReached, 0) + ifThenElse(hostingChildrenReached, hostingChildrenReached, 0)) {
    $parts = true;
}
if (ndpPeopleTargeted && (ndpWomenTargeted || ndpMenTargeted || ndpChildrenTargeted) && ndpPeopleTargeted != ifThenElse(ndpWomenTargeted, ndpWomenTargeted, 0) + ifThenElse(ndpMenTargeted, ndpMenTargeted, 0) + ifThenElse(ndpChildrenTargeted, ndpChildrenTargeted, 0)) {
    $parts = true;
}
if (ndpPeopleReached && (ndpWomenReached || ndpMenReached || ndpChildrenReached) && ndpPeopleReached != ifThenElse(ndpWomenReached, ndpWomenReached, 0) + ifThenElse(ndpMenReached, ndpMenReached, 0) + ifThenElse(ndpChildrenReached, ndpChildrenReached, 0)) {
    $parts = true;
}
if (otherPeopleTargeted && (otherWomenTargeted || otherMenTargeted || otherChildrenTargeted) && otherPeopleTargeted != ifThenElse(otherWomenTargeted, otherWomenTargeted, 0) + ifThenElse(otherMenTargeted, otherMenTargeted, 0) + ifThenElse(otherChildrenTargeted, otherChildrenTargeted, 0)) {
    $parts = true;
}
if (otherPeopleReached && (otherWomenReached || otherMenReached || otherChildrenReached) && otherPeopleReached != ifThenElse(otherWomenReached, otherWomenReached, 0) + ifThenElse(otherMenReached, otherMenReached, 0) + ifThenElse(otherChildrenReached, otherChildrenReached, 0)) {
    $parts = true;
}
