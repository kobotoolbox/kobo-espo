// A new response starts with the standard tasks, in its teams, for its lead
if (entity\isNew()) {
    $tasks = list('Set up the Kobo project', 'Confirm the roster', 'Comms plan', 'Agree site list and standards');
    $i = 0;
    while ($i < array\length($tasks)) {
        record\create('Task', 'name', array\at($tasks, $i), 'status', 'Backlog',
            'cResponseId', id, 'teamsIds', teamsIds, 'assignedUserId', leadId);
        $i = $i + 1;
    }
}

// Closed: its tasks go back to the lead, without collaborators. Taking someone out of the
// response's team doesn't hide the tasks assigned to them or shared with them (EspoCRM's
// "own" access doesn't depend on teams), so this is what leaves them to staff only.
if (!entity\isNew() && entity\isAttributeChanged('status') && status == 'Closed' && leadId) {
    $ids = record\findMany('Task', 1000, 'createdAt', 'asc', 'cResponseId=', id);
    $i = 0;
    while ($i < array\length($ids)) {
        record\update('Task', array\at($ids, $i), 'assignedUserId', leadId, 'collaboratorsIds', list());
        $i = $i + 1;
    }
}
